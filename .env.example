# CropGuard AI Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# ============================================================
# FastAPI Backend Configuration
# ============================================================
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,*

# ============================================================
# Supabase Configuration
# ============================================================
SUPABASE_URL=https://tspdpkyhszrebrclsefz.supabase.co
# Public anonymous key for client/frontend requests:
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key (used strictly in secure backend context if needed, NEVER exposed to client):
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================
# Weather API Configuration
# ============================================================
# By default CropGuard AI uses Open-Meteo (requires no API key).
# Optional: OpenWeatherMap API Key if you want to switch providers.
WEATHER_PROVIDER=open_meteo
OPENWEATHERMAP_API_KEY=your_open_weather_map_key_here

# ============================================================
# Model & Storage Paths
# ============================================================
MODEL_DIR=Backend/ai/saved_models
DATA_DIR=Data/processed
KNOWLEDGE_BASE_PATH=Data/knowledge_base/crop_knowledge.json
